    "border-decorative": "--ks-decorative-border",
    "border-functional": "--ks-functional-border",
    "brand": "--ks-brand",
    "accent": null,
    "urgent": "--ks-urgent",
    "urgent-bg": null,
    "warning": "--ks-warn",
    "warning-bg": null,
    "stable": "--ks-ok",
    "stable-bg": null
  },
  "tokens": {
    "--ks-page-bg": { "role": "surface", "on": null, "value": "#FAF8F2" },
    "--ks-surface": { "role": "surface", "on": null, "value": "#FFFFFF" },
    "--ks-surface-alt": { "role": "surface", "on": null, "value": "#FAF8F5" },
    "--ks-ink": { "role": "text", "on": "--ks-page-bg", "value": "#0F1923" },
    "--ks-body": { "role": "text", "on": "--ks-page-bg", "value": "#2D3142" },
    "--ks-secondary": { "role": "text", "on": "--ks-page-bg", "value": "#4F556B" },
    "--ks-dim": { "role": "text", "on": "--ks-page-bg", "value": "#727270" },
    "--ks-brand": { "role": "text", "on": "--ks-page-bg", "value": "#0059B8" },
    "--ks-on-brand": { "role": "text", "on": "--ks-brand", "value": "#FFFFFF" },
    "--ks-urgent": { "role": "text", "on": "--ks-surface", "value": "#B83B50" },
    "--ks-warn": { "role": "text", "on": "--ks-surface", "value": "#906A2D" },
    "--ks-ok": { "role": "text", "on": "--ks-surface", "value": "#4E7C59" },
    "--ks-functional-border": { "role": "ui-boundary", "on": "--ks-surface", "value": "#8B7355" },
